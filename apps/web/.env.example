# Jëfëli web (apps/web) — copy to .env.local for local development.
# Only NON-SECRET values may use the NEXT_PUBLIC_ prefix: they are embedded in the browser bundle.
# Never put the Supabase service-role key (or any secret) in this app.

# Supabase API URL (local stack default shown).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon/publishable key. The value below is the well-known LOCAL development key
# printed by `supabase start`; use the project's publishable key in staging/production.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Public base URL of this site, used for canonical links, share links and OpenGraph URLs.
# The production domain is not cleared yet.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# local | staging | production — anything but "production" shows an "Environnement de test" banner.
NEXT_PUBLIC_ENV=local
