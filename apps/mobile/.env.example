# Jëfëli mobile — public, non-secret values only (they are embedded in the app bundle).
# On a physical phone with Expo Go / a dev build, use your computer's LAN IP (not 127.0.0.1),
# or the URL of your hosted Supabase project.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_WEB_BASE_URL=http://192.168.1.10:3000
EXPO_PUBLIC_ENV=local
# Optional: EAS project id (enables push notifications in development/production builds)
EXPO_PUBLIC_EAS_PROJECT_ID=
