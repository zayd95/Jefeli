{
  "expo": {
    "name": "Jëfëli",
    "slug": "jefeli",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jefeli",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0B1311",
    "ios": {
      "bundleIdentifier": "sn.jefeli.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Jëfëli utilise la caméra pour prendre des photos et vidéos de vos articles, statuts et lives.",
        "NSPhotoLibraryUsageDescription": "Jëfëli accède à vos photos pour publier des articles, des statuts et des publications.",
        "NSMicrophoneUsageDescription": "Jëfëli utilise le micro pour les messages vocaux, les vidéos et les lives.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "sn.jefeli.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1311",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "jefeli-app-habibjallow95-9380.vercel.app",
              "pathPrefix": "/p/"
            },
            {
              "scheme": "https",
              "host": "jefeli-app-habibjallow95-9380.vercel.app",
              "pathPrefix": "/offer/"
            },
            {
              "scheme": "https",
              "host": "jefeli-app-habibjallow95-9380.vercel.app",
              "pathPrefix": "/u/"
            },
            {
              "scheme": "https",
              "host": "jefeli-app-habibjallow95-9380.vercel.app",
              "pathPrefix": "/post/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Jëfëli",
      "shortName": "Jëfëli",
      "lang": "fr",
      "themeColor": "#0B1311",
      "backgroundColor": "#0B1311"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1311",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Jëfëli accède à vos photos pour publier des articles, des statuts et des publications.",
          "cameraPermission": "Jëfëli utilise la caméra pour prendre des photos et vidéos de vos articles, statuts et lives.",
          "microphonePermission": "Jëfëli utilise le micro pour enregistrer le son de vos vidéos."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Jëfëli utilise le micro pour les messages vocaux."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Jëfëli utilise la caméra pour photographier et filmer vos articles, statuts et Reels.",
          "microphonePermission": "Jëfëli utilise le micro pour enregistrer le son de vos vidéos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Jëfëli affiche votre dernière photo dans la vignette de la galerie du Studio.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo", "video"]
        }
      ],
      "expo-video",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#EFBD38",
          "icon": "./assets/images/android-icon-monochrome.png"
        }
      ],
      "expo-sharing",
      "expo-font",
      "@stream-io/video-react-native-sdk",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Jëfëli utilise la caméra pour vos lives.",
          "microphonePermission": "Jëfëli utilise le micro pour vos lives."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "454e05cc-08f2-4e28-b82c-ee3afe221b4e"
      }
    },
    "owner": "zayd_odo"
  }
}
