# Jëfëli — variable NAMES only. Never commit real secrets.
#
# apps/mobile/.env  (public, embedded in the app bundle)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_WEB_BASE_URL=
EXPO_PUBLIC_ENV=local                 # local | staging | production
EXPO_PUBLIC_EAS_PROJECT_ID=           # enables push in development/production builds
#
# apps/web/.env.local  (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ENV=local
#
# Supabase Edge Function secrets  (server only: `supabase secrets set …`, or supabase/functions/.env locally)
# PUSH_WEBHOOK_SECRET=                # shared secret, also stored in private.config (see docs/SETUP_PRODUCTION.md)
# STREAM_API_KEY=                     # live video provider (Stream). Key may be shown to clients via tokens only
# STREAM_API_SECRET=                  # server only — signs user tokens and verifies webhooks
# EXPO_ACCESS_TOKEN=                  # optional, if enhanced push security is enabled on the Expo project
#
# Supabase Auth (dashboard / config.toml), owner-provided when approved:
# SMS provider credentials (Twilio / MessageBird / Vonage) for phone OTP
# Apple / Facebook OAuth credentials (only after the respective developer accounts / app review)
#
# Local scripts only (never in apps):
# SUPABASE_SERVICE_ROLE_KEY=          # seed-demo.mjs / tests; refuse non-local URLs unless ALLOW_DEMO_SEED=staging
